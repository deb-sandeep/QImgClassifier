      }
    },
    "anthropic/claude-haiku-5.5" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "Haiku*",
      "rateLimit"   : {
        "rpm" : 0,
        "rpd" : 5000
      },
      "costPerMillionToken" : {
