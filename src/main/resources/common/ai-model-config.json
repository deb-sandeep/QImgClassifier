// Global AI model configuration: where models are hosted and what the
// providers enforce. App configs name this file as their "parent" and pick
// the models they use from it (see each app's *.ai.json).
//
// usageLedger : (optional) the file the limits below are counted in across
//               every app that uses this file, so they hold however many
//               apps run at once; ~/ is the home folder. Without it, each
//               app counts only its own requests against them.
//
// gateways : by name
//   enabled               false switches the gateway off with all its models
//   type                  openrouter | ollama
//   url                   the endpoint requests are sent to
//   apiKeyFile            file holding only the API key (openrouter);
//                         ~/ is the home folder, a relative path is relative
//                         to this file's folder when it is on disk
//   connectTimeoutSeconds the longest wait for a connection
//   cooldownSeconds       how long to hold back after a rate limit that
//                         doesn't say how long, or after failing to connect
//   maxParallel           (optional) the provider's cap on requests in flight
//                         across the gateway's models
//   rateLimit             { rpm, rpd }: requests per minute and per UTC day
//                         (reset at 00:00 UTC) across the gateway's models;
//                         0 = no limit
//
// models : by the id sent to the gateway
//   enabled               false switches the model off
//   gateway               the gateway hosting it
//   displayName           (optional) the name shown in the UI
//   rateLimit             (optional) { rpm, rpd } the provider enforces on
//                         this model
//   contextTokens         (optional) context window to ask for (Ollama's
//                         num_ctx; its default of 4096 would cut our prompts)
{
  "usageLedger" : "~/.sconsole/ai-usage.json",

  "gateways" : {
    "openrouter" : {
      "enabled"               : true,
      "type"                  : "openrouter",
      "url"                   : "https://openrouter.ai/api/v1/chat/completions",
      "apiKeyFile"            : "~/projects/workspace/qimgclassifier/open-router.api.key",
      "connectTimeoutSeconds" : 10,
      "cooldownSeconds"       : 300,
      "rateLimit"             : {
        "rpm" : 0,
        "rpd" : 0
      }
    },
    "ollama-home" : {
      "enabled"               : true,
      "type"                  : "ollama",
      "url"                   : "http://192.168.0.149:11434/api/generate",
      "connectTimeoutSeconds" : 10,
      "cooldownSeconds"       : 60,
      "maxParallel"           : 5,
      "rateLimit"             : {
        "rpm" : 0,
        "rpd" : 0
      }
    }
  },

  "models" : {
    "nvidia/nemotron-3.5-super-vl:free" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "Nemotron 3.5S",
      "rateLimit"   : {
        "rpm" : 20,
        "rpd" : 1000
      }
    },
    "nvidia/nemotron-3.5-super-vl" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "Nemotron 3.5S*",
      "rateLimit"   : {
        "rpm" : 0,
        "rpd" : 5000
      }
    },
    "anthropic/claude-haiku-5.5" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "Haiku",
      "rateLimit"   : {
        "rpm" : 0,
        "rpd" : 5000
      }
    },
    "gemma4:latest" : {
      "enabled"       : true,
      "gateway"       : "ollama-home",
      "displayName"   : "Gemma 4",
      "contextTokens" : 12288
    }
  }
}
