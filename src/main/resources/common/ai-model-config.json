      }
    },
    "qwen3.5:27b-q8_0" : {
      "enabled"       : true,
      "gateway"       : "ollama-studio",
      "displayName"   : "Qwen 3.5 27B",
      "costPerMillionToken" : {
        "input"  : 0.0,
        "output" : 0.0
      }
