// Global AI model configuration: where models are hosted and what the
// providers enforce. App configs name this file as their "parent" and pick
// the models they use from it (see each app's *.ai.json).
//
// usageLedger : (optional) the file the limits below are counted in across
//               every app that uses this file, so they hold however many
//               apps run at once; ~/ is the home folder. Without it, each
//               app counts only its own requests against them.
//
// gateways : by name
//   enabled               false switches the gateway off with all its models
//   type                  openrouter | ollama
//   url                   the endpoint requests are sent to
//   apiKeyFile            file holding only the API key (openrouter);
//                         ~/ is the home folder, a relative path is relative
//                         to this file's folder when it is on disk
//   connectTimeoutSeconds the longest wait for a connection
//   cooldownSeconds       how long to hold back after a rate limit that
//                         doesn't say how long, or after failing to connect
//   maxParallel           (optional) the provider's cap on requests in flight
//                         across the gateway's models
//   rateLimit             { rpm, rpd }: requests per minute and per UTC day
//                         (reset at 00:00 UTC) across the gateway's models;
//                         0 = no limit
//
// models : by name: the model id sent to the gateway, unless modelId is set
//   enabled               false switches the model off
//   modelId               (optional) the model id sent to the gateway, when
//                         the name isn't it: one model served by two
//                         gateways is two entries, each with its own name,
//                         gateway and limits, and the same modelId. The apps
//                         and the hub address a model by its name; requests,
//                         transcripts and the server get the modelId. No two
//                         entries may send one modelId to one gateway
//   gateway               the gateway hosting it
//   displayName           (optional) the name shown in the UI
//   rateLimit             (optional) { rpm, rpd } the provider enforces on
//                         this model
//   contextTokens         (optional) context window to ask for (Ollama's
//                         num_ctx); absent: the server's own setting. A
//                         num_ctx other than the one the model is loaded
//                         with makes Ollama reload it
//   costPerMillionToken   (optional) { input, output }: the provider's price in
//                         USD per million tokens; for documentation only,
//                         never used by the processing
//
// aliases : (optional) alias -> model name, so the app files can name a model
//           by a name that outlives it: switching a model is then one edit
//           here. An app file may give an alias wherever it names a model
//           (its models, roots and fallback lists); it is resolved to the
//           model id as the file is read, so the apps, logs, transcripts and
//           the server only ever see model ids. An alias must name a model
//           above, not another alias, and must not itself be a model id; an
//           app file may not configure one model twice, by alias and by id.
{
  "usageLedger" : "~/.sconsole/ai-usage.json",

  "aliases" : {
    "qwen"           : "qwen3.8:27b-q8_0",
    "nemotron"       : "nvidia/nemotron-3.5-super-vl",
    "nemotron:free"  : "nvidia/nemotron-3.5-super-vl:free",
    "haiku"          : "anthropic/claude-haiku-5.5",
    "glm-flash"      : "z-ai/glm-5.3-flash",
    "deepseek-flash" : "deepseek/deepseek-v4.1-flash",
    "inkling"        : "inkling-2-mini:26b-a5b",
    "inkling-149"    : "inkling-2-mini:26b-a5b@149"
  },

  "gateways" : {
    "openrouter" : {
      "enabled"               : true,
      "type"                  : "openrouter",
      "url"                   : "https://openrouter.ai/api/v1/chat/completions",
      "apiKeyFile"            : "~/projects/workspace/qimgclassifier/open-router.api.key",
      "connectTimeoutSeconds" : 10,
      "cooldownSeconds"       : 300,
      "rateLimit"             : {
        "rpm" : 0,
        "rpd" : 0
      }
    },
    "ollama-studio" : {
      "enabled"               : true,
      "type"                  : "ollama",
      "url"                   : "http://mac-studio.local:11434/api/generate",
      "connectTimeoutSeconds" : 10,
      "cooldownSeconds"       : 60,
      "maxParallel"           : 3,
      "rateLimit"             : {
        "rpm" : 0,
        "rpd" : 0
      }
    },
    "ollama-149" : {
      "enabled"               : true,
      "type"                  : "ollama",
      "url"                   : "http://192.168.0.149:11434/api/generate",
      "connectTimeoutSeconds" : 10,
      "cooldownSeconds"       : 60,
      "rateLimit"             : {
        "rpm" : 0,
        "rpd" : 0
      }
    }
  },

  "models" : {
    "nvidia/nemotron-3.5-super-vl:free" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "Nemotron 3.5S",
      "rateLimit"   : {
        "rpm" : 20,
        "rpd" : 1000
      },
      "costPerMillionToken" : {
        "input" : 0.0,
        "output" : 0.0
      }
    },
    "nvidia/nemotron-3.5-super-vl" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "Nemotron 3.5S*",
      "rateLimit"   : {
        "rpm" : 0,
        "rpd" : 5000
      },
      "costPerMillionToken" : {
        "input" : 0.1,
        "output" : 0.4
      }
    },
    "deepseek/deepseek-v4.1-flash" : {
      "enabled"     : true,
      "gateway"     : "openrouter",
      "displayName" : "DeepSeek V4.1*",
      "rateLimit"   : {
        "rpm" : 0,
        "rpd" : 5000
      },
      "costPerMillionToken" : {
        "input" : 0.044,
