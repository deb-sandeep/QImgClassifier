        "frequencyPenalty" : 0,
        "repeatPenalty"    : 1
      },
      "fallback"              : {
        "unreachable" : [ "nvidia/nemotron-3.5-super-vl:free" ],
        "serverError" : [ "nvidia/nemotron-3.5-super-vl:free" ],
        "timeout"     : [ "nvidia/nemotron-3.5-super-vl:free" ],
