// The transcriber's AI models (feature-design.md §4.2). Override with
// -Dai.app.config=<file>.
//
// Every question starts on "transcribe": Qwen (local, with token log
// probabilities for the gate) and the free Nemotron share its queue, each
// taking the next question as a slot frees (Nemotron's have no C; their
// route is "shared"). Qwen has no retries: at temperature 0 a
// retry gives the same reply. A malformed, cut-off or timed-out reply, a
// server error, or Qwen being unreachable sends the question to the free
// Nemotron at once, by Qwen's fallback guards; the paid Nemotron takes over
// once the free one's daily quota is used up. Cascade (the Models tab)
// passes Qwen's questions straight to the free Nemotron.
//
// "physics" (Inkling 2 Mini on ollama-149, a low-end server: one slot)
// takes one in four Physics questions (TranscriberOutcomes.PHYSICS_SHARE),
// which start there alone (route "shared"). It reasons in hidden tokens whatever "reasoning" says,
// and its logprobs include them, so it is asked for none: its replies have
// no C. A failed reply, or .149 being unreachable, falls back to Qwen.
//
// "escalate" (the free Nemotron) is reached by a re-send of a faulty Qwen
// or Inkling transcription, and by a second opinion if gate.route.on.c is set;
// "recheck" (GLM) only by a re-send of a faulty Nemotron transcription
// (the paid Nemotron is the same model, so no help there).
{
  "parent" : "classpath:/common/ai-model-config.json",

  "roots" : {
    "transcribe" : [ "qwen", "nemotron:free" ],
    "physics"    : [ "inkling-149" ],
    "escalate"   : [ "nemotron:free" ],
    "recheck"    : [ "glm-flash" ]
  },

  "models" : {
    "qwen" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 0,
      "reasoning"             : false,
      "maxOutputTokens"       : 4096,
      "logprobs"              : 5,
      "sampler"               : {
        "temperature"      : 0,
        "topK"             : 1,
        "presencePenalty"  : 0,
        "frequencyPenalty" : 0,
        "repeatPenalty"    : 1
      },
      "fallback"              : {
        "unreachable" : [ "nemotron:free" ],
        "serverError" : [ "nemotron:free" ],
        "timeout"     : [ "nemotron:free" ],
        "badReply"    : [ "nemotron:free" ],
        "truncated"   : [ "nemotron:free" ],
        "passthrough" : [ "nemotron:free" ]
      }
    },
    "inkling-149" : {
      "enabled"               : true,
      "maxParallel"           : 1,
      "requestTimeoutSeconds" : 300,
      "retries"               : 0,
      "reasoning"             : false,
      "maxOutputTokens"       : 4096,
      "sampler"               : {
        "temperature"      : 0,
        "topK"             : 1,
        "presencePenalty"  : 0,
        "frequencyPenalty" : 0,
        "repeatPenalty"    : 1
      },
      "fallback"              : {
        "unreachable" : [ "qwen" ],
        "serverError" : [ "qwen" ],
        "timeout"     : [ "qwen" ],
        "badReply"    : [ "qwen" ],
        "truncated"   : [ "qwen" ],
        "passthrough" : [ "qwen" ]
      }
    },
    "nemotron:free" : {
      "enabled"               : true,
      "maxParallel"           : 4,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 4096,
      "promptCaching"         : true,
      "fallback"              : {
        "rateLimitedRPD" : [ "nemotron" ],
        "serverError"    : [ "nemotron" ],
        "passthrough"    : [ "nemotron" ]
      }
    },
    "nemotron" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 4096,
      "promptCaching"         : true
    },
    "glm-flash" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : true,
      "maxOutputTokens"       : 4096,
      "promptCaching"         : true
    }
  }
}
