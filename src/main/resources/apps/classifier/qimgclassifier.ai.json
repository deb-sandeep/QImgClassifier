// The classifier's AI models. Override with -Dai.app.config=<file>.
//
// parent : the global model config (classpath:/... or a file path; a
//          relative path is relative to this file's folder)
// roots  : named pools of entry models. A question may start on either
//          root; ClassifierRouting shares them out: Chemistry to "cloud",
//          Physics / Maths to "local" (overflowing to "cloud" only when no
//          local model can take them), and a local reply that isn't
//          confident enough goes to "cloud" for a second opinion.
// models : the app's policy per model it uses (each must be in the parent)
//   enabled               the app's own switch (on top of the global ones)
//   maxParallel           requests in flight on the model at most (its slots)
//   requestTimeoutSeconds the longest a whole request may take
//   retries               attempts a question gets on the model after a
//                         failed one, before following its fallback
//   reasoning             let the model reason first (costs output tokens)
//   reasoningEffort       (optional, with reasoning) low, medium or high;
//                         absent: the model's default (openrouter models)
//   reasoningMaxTokens    (optional, with reasoning, not with
//                         reasoningEffort) the most tokens it may reason with
//   maxOutputTokens       (optional) the most tokens a reply may have; a
//                         reply cut off there fails as "truncated"
//   promptCaching         mark the prompt cacheable where the model supports
//                         it (openrouter models)
//   rateLimit             (optional) the app's own { rpm, rpd } on the model,
//                         on top of the provider's
//   fallback              (optional) where a question goes once the model
//                         has failed it for good, by why it failed:
//                         rateLimitedRPM, rateLimitedRPD, serverError,
//                         timeout, unreachable, badReply, truncated (a
//                         reply cut off at the length limit; without it,
//                         badReply's), default (for the rest). Each list is
//                         in order of preference: a later
//                         model takes the question only while every earlier
//                         one is held back (rate limit, daily limit,
//                         unreachable), never just because it is busy. While
//                         the model itself is held back, its questions (new
//                         ones too) go by the guard for why: rateLimitedRPD
//                         for a daily limit (its own or its gateway's rpd
//                         used up, or a per-day 429), rateLimitedRPM for
//                         another 429, unreachable. A rate limit uses no
//                         retry; without such a guard (or default) the
//                         question waits for the model. passthrough: where
//                         its questions go while it is set, by hand on the
//                         Models tab (right-click its column), to pass them
//                         through; it then takes none itself.
{
  "parent" : "classpath:/common/ai-model-config.json",

  "roots" : {
    "local" : [ "gemma4:latest" ],
    "cloud" : [ "nvidia/nemotron-3.5-super-vl:free" ]
  },

  "models" : {
    "gemma4:latest" : {
      "enabled"               : false,
      "maxParallel"           : 5,
      "requestTimeoutSeconds" : 300,
      "retries"               : 1,
      "reasoning"             : false,
      "fallback"              : {
        "default" : [ "nvidia/nemotron-3.5-super-vl:free" ]
      }
    },
    "nvidia/nemotron-3.5-super-vl:free" : {
      "enabled"               : true,
      "maxParallel"           : 2,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : false,
      "promptCaching"         : true,
      "fallback"              : {
        "rateLimitedRPD" : [ "nvidia/nemotron-3.5-super-vl" ],
        "passthrough"    : [ "nvidia/nemotron-3.5-super-vl" ]
      }
    },
    "nvidia/nemotron-3.5-super-vl" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : false,
      "promptCaching"         : true
    }
  }
}
