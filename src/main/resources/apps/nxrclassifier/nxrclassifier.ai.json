// The NXR classifier's AI models. Override with -Dai.app.config=<file>.
// The questions the local classifier leaves undecided go to the "nxr" root,
// strictly in table order; see the classifier's qimgclassifier.ai.json for
// what each setting means.
//
// Qwen (local, structured output: the reply's schema comes from
// NXRPrompter) answers them; any failure, or Qwen's server being down,
// sends the question to the free Nemotron, and the paid Nemotron takes over
// once the free one's daily limit is used up, after a server error, or
// while the free one is set to pass its questions through (Models tab).
// Without a usable model in the root the app still runs, with asking the AI
// disabled.
{
  "parent" : "classpath:/common/ai-model-config.json",

  "roots" : {
    "nxr" : [ "qwen" ]
  },

  "models" : {
    "qwen" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 300,
      "retries"               : 1,
      "reasoning"             : false,
      "structuredOutput"      : true,
      "fallback"              : {
        "default" : [ "nemotron:free" ]
      }
    },
    "nemotron:free" : {
      "enabled"               : true,
      "maxParallel"           : 4,
      "requestTimeoutSeconds" : 100,
      "retries"               : 1,
      "reasoning"             : false,
      "promptCaching"         : true,
      "fallback"              : {
        "rateLimitedRPD" : [ "nemotron" ],
        "serverError"    : [ "nemotron" ],
        "passthrough"    : [ "nemotron" ]
      }
    },
    "nemotron" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 100,
      "retries"               : 1,
      "reasoning"             : false,
      "promptCaching"         : true
    }
  }
}
