// The tagger's AI models for the concept pass (qtagger.setup.ai.json has the
// setup pass'). Override with -Dai.app.config=<file>. See the classifier's
// qimgclassifier.ai.json for what each setting means.
//
// Every question goes to the "tier1" root, strictly in table order, and is
// solved blind (the model never sees the key). A tier 1 answer that misses
// the key sends the question on to the "tier2" root, a stronger model that
// solves it again, also blind. Both roots need a usable model, else the
// tagger refuses to start.
//
// Solving needs reasoning, so every model reasons, its reasoning capped below
// maxOutputTokens (reasoningMaxTokens, or GLM's medium effort) so the reply
// still fits: on OpenRouter the limit covers both. A reply that can't be read,
// or names a tag that isn't offered, is sent once more (retries: 1). A reply
// cut off at the length limit goes by the "truncated" guard: Nemotron's to
// GLM, GLM's to Haiku.
{
  "parent" : "classpath:/common/ai-model-config.json",

  "roots" : {
    "tier1" : [ "nvidia/nemotron-3.5-super-vl:free" ],
    "tier2" : [ "z-ai/glm-5.3-flash" ]
  },

  "models" : {
    "nvidia/nemotron-3.5-super-vl:free" : {
      "enabled"               : true,
      "maxParallel"           : 4,
      "requestTimeoutSeconds" : 180,
      "retries"               : 0,
      "reasoning"             : true,
      "reasoningMaxTokens"    : 9000,
      "maxOutputTokens"       : 12000,
      "promptCaching"         : true,
      "fallback"              : {
        "rateLimitedRPD" : [ "nvidia/nemotron-3.5-super-vl" ],
        "serverError"    : [ "nvidia/nemotron-3.5-super-vl" ],
        "passthrough"    : [ "nvidia/nemotron-3.5-super-vl" ],
        "truncated"      : [ "z-ai/glm-5.3-flash" ]
      }
    },
    "nvidia/nemotron-3.5-super-vl" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : true,
      "reasoningMaxTokens"    : 9000,
      "maxOutputTokens"       : 12000,
      "promptCaching"         : true,
      "fallback"              : {
        "truncated" : [ "z-ai/glm-5.3-flash" ]
      }
    },
    "z-ai/glm-5.3-flash" : {
      "enabled"               : true,
      "maxParallel"           : 6,
      "requestTimeoutSeconds" : 300,
      "retries"               : 1,
      "reasoning"             : true,
      "reasoningEffort"       : "medium",
      "maxOutputTokens"       : 16000,
      "promptCaching"         : true,
      "fallback"              : {
        "timeout"   : [ "anthropic/claude-haiku-5.5" ],
        "truncated" : [ "anthropic/claude-haiku-5.5" ]
      }
    },
    "anthropic/claude-haiku-5.5" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 300,
      "retries"               : 0,
      "reasoning"             : true,
      "reasoningMaxTokens"    : 8000,
      "maxOutputTokens"       : 16000,
      "promptCaching"         : true
    }
  }
}
