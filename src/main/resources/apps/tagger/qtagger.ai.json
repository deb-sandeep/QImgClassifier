// The tagger's AI models. Override with -Dai.app.config=<file>. See the
// classifier's qimgclassifier.ai.json for what each setting means.
//
// The questions go to the "llm" root, strictly in table order. The model only
// reads the question and lists its tags: nothing is solved, so reasoning is
// off, and the reply, a short tag list, is capped small (maxOutputTokens).
//
// Qwen (local) and the free Nemotron share the "llm" root, each taking the
// next question as a slot frees. A question Qwen fails (once retried) goes
// to the free Nemotron. Once the free Nemotron's daily quota is used up
// (rateLimitedRPD) its questions go to Qwen, never to the paid one; the paid
// Nemotron takes over only after a server error, or while the free one is set
// to pass its questions through (Cascade, the Models tab). A reply that can't
// be read is sent once more (retries: 1).
//
// The "other" root is reached only by the row menu's Send to model, for a
// second look by a different model: a question is pinned to the model chosen,
// so these models take nothing by themselves.
{
  "parent" : "classpath:/common/ai-model-config.json",

  "roots" : {
    "llm"   : [ "qwen3.5:27b-q8_0", "nvidia/nemotron-3.5-super-vl:free" ],
    "other" : [
      "deepseek/deepseek-v4.1-flash"
    ]
  },

  "models" : {
    "qwen3.5:27b-q8_0" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 300,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 4096,
      "fallback"              : {
        "default" : [ "nvidia/nemotron-3.5-super-vl:free" ]
      }
    },
    "nvidia/nemotron-3.5-super-vl:free" : {
      "enabled"               : true,
      "maxParallel"           : 4,
      "requestTimeoutSeconds" : 90,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 1500,
      "promptCaching"         : true,
      "fallback"              : {
        "rateLimitedRPD" : [ "qwen3.5:27b-q8_0" ],
        "serverError"    : [ "nvidia/nemotron-3.5-super-vl" ],
        "passthrough"    : [ "nvidia/nemotron-3.5-super-vl" ]
      }
    },
    "nvidia/nemotron-3.5-super-vl" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 90,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 1500,
      "promptCaching"         : true
    },
    "deepseek/deepseek-v4.1-flash" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 120,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 1500,
      "promptCaching"         : true
    },
    "anthropic/claude-haiku-5.5" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 120,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 1500,
      "promptCaching"         : true
    },
    "z-ai/glm-5.3-flash" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 120,
      "retries"               : 1,
      "reasoning"             : false,
      "maxOutputTokens"       : 1500,
      "promptCaching"         : true
    }
  }
}
