// The topic reviewer's AI models. Override with -Dai.app.config=<file>.
// The questions go to the "review" root, strictly in table order; see the
// classifier's qimgclassifier.ai.json for what each setting means.
//
// The paid Nemotron is used only while the free one is held back by a rate
// limit or can't be reached. To review with Claude Haiku instead, put it in
// the root and enable it.
{
  "parent" : "classpath:/common/ai-model-config.json",

  "roots" : {
    "review" : [ "nvidia/nemotron-3.5-super-vl:free" ]
  },

  "models" : {
    "nvidia/nemotron-3.5-super-vl:free" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 1,
      "reasoning"             : false,
      "promptCaching"         : true,
      "rateLimit"             : { "rpm" : 0, "rpd" : 1000 },
      "fallback" : {
        "rateLimited" : [ "nvidia/nemotron-3.5-super-vl" ],
        "unreachable" : [ "nvidia/nemotron-3.5-super-vl" ]
      }
    },
    "nvidia/nemotron-3.5-super-vl" : {
      "enabled"               : true,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 180,
      "retries"               : 0,
      "reasoning"             : false,
      "promptCaching"         : true
    },
    "anthropic/claude-haiku-5.5" : {
      "enabled"               : false,
      "maxParallel"           : 3,
      "requestTimeoutSeconds" : 120,
      "retries"               : 0,
      "reasoning"             : false,
      "promptCaching"         : true
    }
  }
}
